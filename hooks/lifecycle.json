  "instructions": {
    "pre_task": "hooks/pre-task.md",
    "pre_write": "hooks/pre-write.md",
    "post_write": "hooks/post-write.md",
    "pre_verify": "hooks/pre-verify.md",
    "pre_deploy": "hooks/pre-deploy.md",
