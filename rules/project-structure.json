{
  "version": 1,
  "framework": "aws",
  "target_root": ".",
  "required_paths": [
    "infra/modules", "infra/environments/development", "infra/environments/staging",
    "infra/environments/production", "infra/README.md",
    ".github/workflows/ci.yml", ".github/workflows/infrastructure-plan.yml",
    ".github/workflows/build-images.yml", ".github/workflows/deploy-staging.yml",
    ".github/workflows/deploy-production.yml", ".github/workflows/rollback.yml",
    ".github/workflows/drift-detection.yml", "ops/runbooks/deployment.md",
    "ops/runbooks/rollback.md", "ops/runbooks/database-migration.md",
    "ops/runbooks/disaster-recovery.md", "ops/alerts", "ops/dashboards",
    "docs/deployment/deployment-contract.md", "docs/deployment/aws-architecture.md"
  ],
  "required_directories": [
    "infra/modules", "infra/environments/development", "infra/environments/staging",
    "infra/environments/production", "ops/alerts", "ops/dashboards"
  ],
  "forbidden_globs": ["**/*.tfstate", "**/*.tfstate.*", "**/*.tfplan", "**/.terraform/**", "**/*.pem", "**/*.key"],
  "required_text": {
    "docs/deployment/aws-architecture.md": ["CloudFront", "ECS", "PostgreSQL", "Redis", "rollback"],
    "ops/runbooks/database-migration.md": ["compatible", "singleton", "abort"],
    ".github/workflows/deploy-production.yml": ["environment", "concurrency", "digest"]
  }
}
